/**
 * Core Philosophy:
 * This ruleset establishes a public, write-once, read-many security model for submissions,
 * and a restricted-write, public-read model for exam structure.
 *
 * Data Structure:
 * - `submissions`: Stores user-submitted OMR data. Publicly readable and writable for creation.
 * - `examSections`: Stores the structure of the multi-section exam.
 *   It is publicly readable but writable only by authenticated administrators.
 * - `examConfig`: Stores global exam settings. It is publicly readable and writable only by authenticated admins.
 *
 * Key Security Decisions:
 * - Public Read Access: Anyone can read submissions and the exam structure.
 * - Public Create Access for Submissions: Anyone can create new submissions.
 * - No Updates or Deletes on Submissions: Submissions are immutable after creation.
 * - Restricted Writes for Exam Structure: Only authenticated users can manage the exam structure.
 *   This is a placeholder for a more robust admin-only rule.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description
     *   Allows any user (anonymous or authenticated) to read and create
     *   submissions. Critically, it prevents anyone from updating or deleting
     *   existing submissions to ensure data integrity.
     */
    match /submissions/{submissionId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description
     *   Allows public read access to the multi-section exam structure.
     *   Write access is restricted to authenticated users for the admin panel.
     */
    match /examSections/{sectionId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if request.auth != null;
    }

    /**
     * @description
     *   Allows public read access to the main exam configuration.
     *   Write access is restricted to authenticated users for the admin panel.
     *   This document is a singleton, so only create/update on the 'main' doc is allowed.
     */
    match /examConfig/main {
      allow get: if true;
      allow create, update: if request.auth != null;
      // No list, delete, or other paths needed.
    }
  }
}
