/**
 * Core Philosophy:
 * This ruleset establishes a public, write-once, read-many security model for submissions,
 * and a restricted-write, public-read model for exam structure.
 *
 * Data Structure:
 * - `submissions`: Stores user-submitted OMR data. Publicly readable and writable for creation.
 * - `examSections`: Stores the structure of the exam (e.g., sections and question counts).
 *   It is publicly readable but writable only by authenticated administrators (future-proofing).
 *   For now, we will allow any authenticated user to write, assuming an admin role will be added later.
 *
 * Key Security Decisions:
 * - Public Read Access: Anyone can read submissions and the exam structure.
 * - Public Create Access for Submissions: Anyone can create new submissions.
 * - No Updates or Deletes on Submissions: Submissions are immutable after creation.
 * - Restricted Writes for Exam Sections: Only authenticated users can manage the exam structure.
 *   This is a placeholder for a more robust admin-only rule.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description
     *   Allows any user (anonymous or authenticated) to read and create
     *   submissions. Critically, it prevents anyone from updating or deleting
     *   existing submissions to ensure data integrity.
     */
    match /submissions/{submissionId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description
     *   Allows public read access to the exam structure. Write access is
     *   restricted to authenticated users, intended for an admin panel.
     *   This allows the app to dynamically fetch the exam layout while
     *   protecting it from public modification.
     * @note
     *   The write rule `if request.auth != null;` is a placeholder. In a
     *   production app, this should be replaced with a more secure rule that
     *   checks for a specific admin role or claim on the user's token.
     */
    match /examSections/{sectionId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if request.auth != null;
    }
  }
}
